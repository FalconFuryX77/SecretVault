# Copy to server/.env and fill in. Keep it secret; don't commit it.

# The name people's phones connect to (an A/AAAA record pointing at this
# machine). Caddy gets a certificate for it.
SYNC_DOMAIN=backup.example.org

# Long random strings, e.g. from: openssl rand -base64 32
SYNC_DB_PASSWORD=
SYNC_S3_PASSWORD=

# Who may create accounts: give each person or team a code. Comma-separated.
SYNC_INVITE_CODES=

# Optional: other ports (for testing on a machine where 80/443 are taken).
# SYNC_HTTP_PORT=80
# SYNC_HTTPS_PORT=443
